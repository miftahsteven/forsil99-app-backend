datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// USER ACCOUNT & AUTHENTICATION
// ==============================================================================

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  phoneNumber        String?   @unique
  passwordHash       String?
  googleUid          String?   @unique
  roles              String[]  @default(["alumni"])
  verificationStatus String    @default("approved") // 'draft' | 'submitted' | 'under_review' | 'need_revision' | 'approved' | 'rejected' | 'suspended'
  isActive           Boolean   @default(true)
  fcmTokens          String[]  @default([])
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  profile            Profile?
  posts              Post[]
  reactions          PostReaction[]
  comments           Comment[]
  stories            Story[]
  shops              Shop[]
  products           Product[]
  eventRsvps         EventRsvp[]
  sentMessages       ChatMessage[]
  notifications      Notification[] @relation("RecipientNotifications")
  reportsCreated     Report[]       @relation("UserReports")
  following          Follow[]       @relation("UserFollowing")
  followers          Follow[]       @relation("UserFollowers")
  memorialFlowers    MemorialFlower[]
  memorialPrayers    MemorialPrayer[]

  @@map("users")
}

// ==============================================================================
// ALUMNI PROFILE (1-to-1 WITH USER)
// ==============================================================================

model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName        String
  nickname        String?
  profilePhotoUrl String?
  coverPhotoUrl   String?
  graduationYear  Int       @default(1999)
  schoolCode      String    @default("SMAN59JKT")
  className       String?   // e.g. '3 IPA 1', '3 IPS 2'
  major           String?   // e.g. 'IPA', 'IPS', 'Bahasa'
  nia             String?   // Nomor Induk Alumni
  birthDate       String?
  city            String?
  province        String?
  occupation      String?
  company         String?
  businessField   String?
  bio             String?
  skills          String[]  @default([])
  interests       String[]  @default([])
  socialLinks     Json?     @default("{}")
  privacy         Json?     @default("{\"phone\":\"same_class\",\"birthDate\":\"verified_alumni\",\"occupation\":\"verified_alumni\",\"lastSeen\":\"verified_alumni\"}")
  verifiedAt      DateTime?
  sellerStatus    String    @default("none") // 'none' | 'pending' | 'approved' | 'rejected' | 'suspended'
  searchKeywords  String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("profiles")
}

// ==============================================================================
// USER FOLLOW RELATIONSHIPS
// ==============================================================================

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

// ==============================================================================
// ALUMNI REGISTRATION & REFERRAL WORKFLOW
// ==============================================================================

model AlumniRegistration {
  id                 String    @id @default(uuid())
  googleUid          String    @unique
  googleEmail        String
  fullName           String
  nickname           String?
  className          String
  whatsapp           String
  referralAccountId  String
  referralName       String
  selfieBase64       String?   @db.Text
  selfieUrl          String?
  status             String    @default("submitted") // 'submitted' | 'under_review' | 'approved' | 'rejected'
  adminNotes         String?
  revisionMessage    String?
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("alumni_registrations")
}

// ==============================================================================
// COMMUNITY FEEDS, POSTS & NOSTALGIA CAPSULE
// ==============================================================================

model Post {
  id               String         @id @default(uuid())
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  type             String         @default("standard") // 'standard' | 'memory' | 'announcement' | 'help' | 'event' | 'shop_share'
  text             String         @db.Text
  media            Json?          @default("[]") // Array of { type: 'image'|'video', url: string, caption?: string }
  visibility       String         @default("verified_alumni") // 'verified_alumni' | 'same_class' | 'only_me' | 'public'
  memoryMeta       Json?          @default("{}") // { year?: number, locationName?: string, album?: string, isThenAndNow?: boolean, thenPhotoUrl?: string, nowPhotoUrl?: string }
  linkedProductId  String?
  linkedEventId    String?
  reactionCount    Int            @default(0)
  commentCount     Int            @default(0)
  saveCount        Int            @default(0)
  isPinned         Boolean        @default(false)
  commentsEnabled  Boolean        @default(true)
  moderationStatus String         @default("visible") // 'visible' | 'hidden' | 'removed' | 'under_review'
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  reactions        PostReaction[]
  comments         Comment[]

  @@map("posts")
}

model PostReaction {
  id           String   @id @default(uuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactionType String   // 'suka' | 'kangen' | 'salut' | 'semangat'
  createdAt    DateTime @default(now())

  @@unique([postId, userId])
  @@map("post_reactions")
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  text      String    @db.Text
  likeCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("comments")
}

// ==============================================================================
// 24-HOUR EPHEMERAL STORIES
// ==============================================================================

model Story {
  id         String   @id @default(uuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaType  String   @default("image") // 'image' | 'video'
  mediaUrl   String   @db.Text
  caption    String?  @db.Text
  visibility String   @default("verified_alumni")
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@map("stories")
}

// ==============================================================================
// SELLER 99 & UMKM DIRECTORY
// ==============================================================================

model Shop {
  id            String    @id @default(uuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String
  logoUrl       String?
  description   String    @db.Text
  categoryIds   String[]  @default([])
  businessType  String    @default("product") // 'product' | 'service' | 'both'
  city          String?
  serviceAreas  String[]  @default([])
  contactPhone  String?
  contactMethod String    @default("chat") // 'chat' | 'phone' | 'whatsapp'
  status        String    @default("approved") // 'draft' | 'pending' | 'approved' | 'rejected' | 'suspended'
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  products      Product[]

  @@map("shops")
}

model Product {
  id           String   @id @default(uuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  type         String   @default("product") // 'product' | 'service'
  categoryId   String
  categoryName String
  description  String   @db.Text
  imageUrls    String[] @default([])
  priceType    String   @default("fixed") // 'fixed' | 'starting_from' | 'contact_seller'
  price        Float?
  unit         String?  // e.g. 'porsi', 'box', 'm2', 'jam'
  city         String?
  serviceAreas String[] @default([])
  status       String    @default("active") // 'draft' | 'active' | 'out_of_stock' | 'inactive'
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("products")
}

// ==============================================================================
// ALUMNI EVENTS & RSVP
// ==============================================================================

model Event {
  id            String      @id @default(uuid())
  title         String
  description   String      @db.Text
  coverUrl      String?
  startAt       DateTime
  endAt         DateTime?
  locationName  String
  address       String?
  organizerName String
  organizerId   String?
  attendeeCount Int         @default(0)
  status        String      @default("published") // 'published' | 'completed' | 'cancelled'
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  rsvps         EventRsvp[]

  @@map("events")
}

model EventRsvp {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   // 'hadir' | 'mungkin' | 'tidak'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@map("event_rsvps")
}

// ==============================================================================
// LIVE RADAR LOCATION
// ==============================================================================

model LiveLocation {
  userId    String   @id
  fullName  String
  nickname  String?
  photoUrl  String?
  className String?
  isSharing Boolean  @default(true)
  lat       Float
  lng       Float
  cityName  String
  areaName  String
  updatedAt DateTime @default(now())

  @@map("live_locations")
}

// ==============================================================================
// CHAT & INSTANT MESSAGING
// ==============================================================================

model ChatThread {
  id              String        @id @default(uuid())
  memberIds       String[]      // Array of user IDs [user1, user2]
  lastMessageText String?
  lastMessageAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  messages        ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String     @db.Text
  imageUrl  String?
  isRead    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@map("chat_messages")
}

// ==============================================================================
// IN-APP NOTIFICATIONS
// ==============================================================================

model Notification {
  id            String   @id @default(uuid())
  recipientId   String
  recipient     User     @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId       String?
  actorName     String?
  actorPhotoUrl String?
  type          String   // 'verification' | 'reaction' | 'comment' | 'chat' | 'shop' | 'event' | 'system'
  title         String
  body          String
  isRead        Boolean  @default(false)
  data          Json?    @default("{}")
  createdAt     DateTime @default(now())

  @@map("notifications")
}

// ==============================================================================
// MODERATION & REPORTS
// ==============================================================================

model Report {
  id            String   @id @default(uuid())
  reporterId    String
  reporter      User     @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType    String   // 'post' | 'comment' | 'user' | 'product' | 'chat'
  targetId      String
  targetSummary String?
  category      String
  description   String?
  status        String   @default("open") // 'open' | 'reviewing' | 'resolved' | 'dismissed'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reports")
}

// ==============================================================================
// MASTER DATA (SMAN 59 JAKARTA ANGKATAN 1999)
// ==============================================================================

model MasterSchool {
  id        String   @id @default("sman59-jakarta")
  code      String   @unique @default("SMAN59JKT")
  name      String   @default("SMA Negeri 59 Jakarta")
  shortName String   @default("SMAN 59")
  city      String   @default("Jakarta Timur")
  province  String   @default("DKI Jakarta")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("master_schools")
}

model MasterCohort {
  id             String   @id @default("sman59-1999")
  schoolId       String   @default("sman59-jakarta")
  graduationYear Int      @default(1999)
  displayName    String   @default("Angkatan 1999 (Perak)")
  isLaunchCohort Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("master_cohorts")
}

model MasterClass {
  id             String   @id
  schoolId       String   @default("sman59-jakarta")
  cohortId       String   @default("sman59-1999")
  graduationYear Int      @default(1999)
  name           String
  major          String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("master_classes")
}

model ProductCategory {
  id        String  @id
  name      String
  sortOrder Int     @default(1)
  isActive  Boolean @default(true)

  @@map("product_categories")
}

// ==============================================================================
// IN MEMORIAM / ALUMNI YANG TELAH TIADA
// ==============================================================================

model DeceasedAlumni {
  id             String           @id @default(uuid())
  fullName       String
  nickname       String?
  className      String?          // e.g. '3 IPA 1'
  photoUrl       String?
  passedAwayYear Int              // e.g. 2018
  passedAwayDate String?          // e.g. '12 Mei 2018'
  bio            String?          @db.Text // Pesan / untaian kenangan
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  flowers        MemorialFlower[]
  prayers        MemorialPrayer[]

  @@map("deceased_alumni")
}

model MemorialFlower {
  id         String         @id @default(uuid())
  deceasedId String
  deceased   DeceasedAlumni @relation(fields: [deceasedId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime       // Now + 30 days
  createdAt  DateTime       @default(now())

  @@index([deceasedId, userId, expiresAt])
  @@map("memorial_flowers")
}

model MemorialPrayer {
  id         String         @id @default(uuid())
  deceasedId String
  deceased   DeceasedAlumni @relation(fields: [deceasedId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text       String         @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([deceasedId, createdAt])
  @@map("memorial_prayers")
}
